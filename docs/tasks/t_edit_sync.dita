<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="t_edit_sync" class="- topic/topic task/task ">
  <title class="- topic/title ">Edit a Sync</title>
  <shortdesc class="- topic/shortdesc ">Update the configuration of an existing sync, for example to change its name,
    schedule, field mapping, or credentials.</shortdesc>
  <prolog class="- topic/prolog ">
    <metadata class="- topic/metadata ">
      <audience type="user" class="- topic/audience "/>
    </metadata>
  </prolog>
  <taskbody class="- topic/body task/taskbody ">
    <steps class="- topic/ol task/steps ">
      <step class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd ">In the navigation menu, click <uicontrol class="+ topic/ph ui-d/uicontrol ">Syncs</uicontrol>.</cmd>
      </step>
      <step class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd ">Click the name of the sync you want to edit.</cmd>
        <info class="- topic/itemgroup task/info ">The Sync Detail page opens.</info>
      </step>
      <step class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd ">Click <uicontrol class="+ topic/ph ui-d/uicontrol ">Edit</uicontrol>.</cmd>
        <info class="- topic/itemgroup task/info ">The Edit Sync form opens with the current values pre-filled.</info>
      </step>

      <step conref="conref_sync_form.dita#sync-form-steps/step-enter-name" class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd "/>
      </step>
      <step conref="conref_sync_form.dita#sync-form-steps/step-select-adapter" class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd "/>
      </step>
      <step conref="conref_sync_form.dita#sync-form-steps/step-select-connector" class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd "/>
      </step>
      <step conref="conref_sync_form.dita#sync-form-steps/step-deployment-id" class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd "/>
      </step>
      <step conref="conref_sync_form.dita#sync-form-steps/step-select-credential" class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd "/>
      </step>
      <step conref="conref_sync_form.dita#sync-form-steps/step-configure-schedule" class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd "/>
      </step>
      <step conref="conref_sync_form.dita#sync-form-steps/step-field-mapping" class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd "/>
      </step>
      <step conref="conref_sync_form.dita#sync-form-steps/step-category-mapping" class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd "/>
      </step>

      <step class="- topic/li task/step ">
        <cmd class="- topic/ph task/cmd ">Click <uicontrol class="+ topic/ph ui-d/uicontrol ">Save Changes</uicontrol>.</cmd>
        <stepresult class="- topic/itemgroup task/stepresult ">The updated configuration is saved and you are returned to the Sync Detail
          page. If you changed the schedule, the new schedule takes effect immediately.</stepresult>
      </step>
    </steps>
  </taskbody>
</task>