# ── hop-core required ─────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-32-chars-minimum-secret-key
JWT_SECRET_KEY=change-me-32-chars-minimum-jwt-key!!
ENCRYPTION_KEY=  # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=sqlite:///./data/syndication.db  # dev only — use postgresql+psycopg2://... in production
REDIS_URL=

# ── hop-core optional ─────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
CORS_ORIGINS=http://localhost:4200
COOKIE_SECURE=false
SINGLE_ORG_MODE=true
SINGLE_ORG_SLUG=syndication
FRONTEND_BASE_URL=http://localhost:4200

# ── SMTP (password reset / invitations) — optional, leave blank to disable ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Syndication Service

# ── First-run admin (Docker / unattended installs) ────────────────────────────
# If set and no admin account exists yet, one is created automatically at
# startup. Safe to leave in place — it is a no-op after the first run.
# Password must be 12+ chars with an uppercase letter, a digit, and a special char.
# For local dev, run 'python scripts/seed.py' instead (interactive prompt).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Heretto Deploy API (source) ────────────────────────────────────────────────
# Credentials are stored per-sync via hop-core Credential model;
# these are defaults used when not overridden by a stored credential.
DEPLOY_DEFAULT_AUDIENCE=private

# ── Sync executor ─────────────────────────────────────────────────────────────
SYNC_MAX_CONSECUTIVE_FAILURES=5
SYNC_RETENTION_DAYS=90
SYNC_TIMEOUT_SECONDS=3600

# ── Retry ─────────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RETRY_BACKOFF_MULTIPLIER=2.0
